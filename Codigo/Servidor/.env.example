# Modelo do arquivo .env (copie este arquivo, renomeie para .env e preencha com os SEUS dados)
# Autor: Pedro Tafner
# O .env verdadeiro tem senha e NÃO vai para o GitHub (está no .gitignore)

# Endereço do servidor Oracle da PUC
ORACLE_HOST=
# Porta do Oracle (normalmente 1521)
ORACLE_PORT=
# Nome do serviço do banco
ORACLE_SERVICE=
# Seu usuário e senha pessoais do banco
ORACLE_USER=
ORACLE_PASSWORD=
# Porta do servidor da API (se ficar vazio, usa 3000)
PORT=
